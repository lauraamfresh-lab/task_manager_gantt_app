# Cadena de conexión a la base de datos PostgreSQL (Render la genera automáticamente
# al crear la base de datos; cópiala desde el panel de Render).
DATABASE_URL="postgresql://usuario:password@host:5432/nombre_bd"

# Secreto para firmar los JWT de sesión. Genera uno aleatorio y largo, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambia-esto-por-un-valor-aleatorio-largo"

# Puerto en el que arranca Express (Render lo asigna automáticamente vía la
# variable PORT; en local puedes dejar 4000)
PORT=4000

NODE_ENV=development

# Solo se usan una vez, al ejecutar `npm run seed`, para crear el primer ADMIN
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="cambia-esta-contraseña"
ADMIN_NOMBRE="Admin"
